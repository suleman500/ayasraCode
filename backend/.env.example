# انسخ هذا الملف باسم .env (داخل مجلد backend) للتشغيل المحلي.
# على Render ضع نفس المتغيرات في Environment، ولا ترفع .env إلى GitHub أبداً.

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/aysar?retryWrites=true&w=majority
# نص عشوائي طويل (32+ حرفاً). توليده: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# اختياري: نموذج أقوى للمحادثة فقط
GEMINI_CHAT_MODEL=

# بيانات الحساب (تُستخدم فقط عند تشغيل npm run seed)
ADMIN_USER=
ADMIN_PASS=

# محلياً: 127.0.0.1 ، وعلى Render: 0.0.0.0
HOST=127.0.0.1
# على Render اجعله production
NODE_ENV=development

# الجسر المحلي (المجلدات وتشغيل الكود وVS Code): true على جهازك فقط. على Render اتركه فارغاً.
ENABLE_BRIDGE=

# سياسة CSP تبدأ بوضع المراقبة. بعد أن تتأكد أن المحرر يعمل بلا مخالفات في Console اجعلها true
CSP_ENFORCE=

# عناوين مسموح لها بالاتصال من تطبيق/موقع آخر (مفصولة بفواصل). اتركها فارغة الآن.
CORS_ORIGINS=
